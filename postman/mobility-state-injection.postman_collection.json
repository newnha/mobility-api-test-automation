{
  "info": {
    "name": "Vehicle - 차량 상태값 주입 & 검증",
    "description": "가상 스펙(spec/openapi.yaml) 기반으로 도메인별(카셰어링, 비대면) 상태 변경 API(PUT /test-fixtures/vehicles/:vehicle_id)를 정리한 컬렉션.\nUI를 거치지 않고 Payload로 차량 상태(door_state, power_state, charge_percent 등)를 직접 주입하고, 반영 여부를 검증한다.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:4010" },
    { "key": "access_token", "value": "local-mock-token" },
    { "key": "vehicle_id", "value": "FIXTURE-0001" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "카셰어링",
      "item": [
        {
          "name": "문 열림 상태 세팅 (door_state=OPEN)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/test-fixtures/vehicles/{{vehicle_id}}",
              "host": ["{{base_url}}"],
              "path": ["test-fixtures", "vehicles", "{{vehicle_id}}"]
            },
            "body": { "mode": "raw", "raw": "{\n  \"door_state\": \"OPEN\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('상태코드 200', () => pm.response.to.have.status(200));",
                  "pm.test('응답 스키마 검증', () => {",
                  "  pm.expect(body).to.have.property('vehicle_id');",
                  "  pm.expect(body).to.have.property('door_state').that.is.a('string');",
                  "  pm.expect(body).to.have.property('power_state').that.is.a('string');",
                  "  pm.expect(body).to.have.property('lock_state').that.is.a('string');",
                  "  pm.expect(body).to.have.property('charge_percent').that.is.a('number');",
                  "  pm.expect(body).to.have.property('updated_at');",
                  "});",
                  "pm.test('주입한 상태값이 반영됨 (door_state=OPEN)', () => {",
                  "  pm.expect(body.door_state).to.eql('OPEN');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "시동 ON 상태 세팅 (power_state=ON)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/test-fixtures/vehicles/{{vehicle_id}}",
              "host": ["{{base_url}}"],
              "path": ["test-fixtures", "vehicles", "{{vehicle_id}}"]
            },
            "body": { "mode": "raw", "raw": "{\n  \"power_state\": \"ON\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('상태코드 200', () => pm.response.to.have.status(200));",
                  "pm.test('주입한 상태값이 반영됨 (power_state=ON)', () => {",
                  "  pm.expect(body.power_state).to.eql('ON');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "배터리 부족 경계값 세팅 (charge_percent=15)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/test-fixtures/vehicles/{{vehicle_id}}",
              "host": ["{{base_url}}"],
              "path": ["test-fixtures", "vehicles", "{{vehicle_id}}"]
            },
            "body": { "mode": "raw", "raw": "{\n  \"charge_percent\": 15\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('상태코드 200', () => pm.response.to.have.status(200));",
                  "pm.test('경계값이 정확히 반영됨 (15)', () => {",
                  "  pm.expect(body.charge_percent).to.eql(15);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "비대면",
      "item": [
        {
          "name": "원격 잠금 해제 세팅 (lock_state=UNLOCKED)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/test-fixtures/vehicles/{{vehicle_id}}",
              "host": ["{{base_url}}"],
              "path": ["test-fixtures", "vehicles", "{{vehicle_id}}"]
            },
            "body": { "mode": "raw", "raw": "{\n  \"lock_state\": \"UNLOCKED\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('상태코드 200', () => pm.response.to.have.status(200));",
                  "pm.test('주입한 상태값이 반영됨 (lock_state=UNLOCKED)', () => {",
                  "  pm.expect(body.lock_state).to.eql('UNLOCKED');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "유효하지 않은 배터리 값 거부 (charge_percent=150)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/test-fixtures/vehicles/{{vehicle_id}}",
              "host": ["{{base_url}}"],
              "path": ["test-fixtures", "vehicles", "{{vehicle_id}}"]
            },
            "body": { "mode": "raw", "raw": "{\n  \"charge_percent\": 150\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('범위를 벗어난 값은 422로 거부됨', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "공통",
      "item": [
        {
          "name": "차량 상태 조회 (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/test-fixtures/vehicles/{{vehicle_id}}",
              "host": ["{{base_url}}"],
              "path": ["test-fixtures", "vehicles", "{{vehicle_id}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('상태코드 200', () => pm.response.to.have.status(200));",
                  "pm.test('필수 필드가 모두 존재', () => {",
                  "  ['vehicle_id','door_state','power_state','lock_state','charge_percent','updated_at']",
                  "    .forEach((k) => pm.expect(body).to.have.property(k));",
                  "});",
                  "pm.test('vehicle_id가 요청한 차량과 일치', () => {",
                  "  pm.expect(body.vehicle_id).to.eql(pm.variables.get('vehicle_id'));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
