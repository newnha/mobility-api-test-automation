{
  "info": {
    "name": "Mobility - 차량 상태값 주입 & 검증",
    "description": "Swagger 명세 기반으로 도메인별 핵심 상태 변경 API(PUT /test/cars/:car_id)를 정리한 컬렉션.\nUI를 거치지 않고 Payload로 차량 상태(is_door_open, is_engine_on, remaining_percentage 등)를 직접 주입하고, 반영 여부를 검증한다.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:4010" },
    { "key": "access_token", "value": "local-mock-token" },
    { "key": "car_id", "value": "TEST-CAR-0001" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "prerequisite",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.variables.get('car_id')) {",
          "  pm.variables.set('car_id', 'TEST-CAR-0001');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "카셰어링",
      "item": [
        {
          "name": "문 열림 상태 주입 (is_door_open=true)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/test/cars/{{car_id}}",
              "host": ["{{base_url}}"],
              "path": ["test", "cars", "{{car_id}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_door_open\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('상태코드 200', () => pm.response.to.have.status(200));",
                  "pm.test('응답 스키마 검증', () => {",
                  "  pm.expect(body).to.have.property('car_id');",
                  "  pm.expect(body).to.have.property('is_door_open').that.is.a('boolean');",
                  "  pm.expect(body).to.have.property('is_engine_on').that.is.a('boolean');",
                  "  pm.expect(body).to.have.property('is_locked').that.is.a('boolean');",
                  "  pm.expect(body).to.have.property('remaining_percentage').that.is.a('number');",
                  "  pm.expect(body).to.have.property('updated_at');",
                  "});",
                  "pm.test('주입한 상태값이 반영됨 (is_door_open=true)', () => {",
                  "  pm.expect(body.is_door_open).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "시동 ON 상태 주입 (is_engine_on=true)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/test/cars/{{car_id}}",
              "host": ["{{base_url}}"],
              "path": ["test", "cars", "{{car_id}}"]
            },
            "body": { "mode": "raw", "raw": "{\n  \"is_engine_on\": true\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('상태코드 200', () => pm.response.to.have.status(200));",
                  "pm.test('주입한 상태값이 반영됨 (is_engine_on=true)', () => {",
                  "  pm.expect(body.is_engine_on).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "배터리 부족 경계값 주입 (remaining_percentage=15)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/test/cars/{{car_id}}",
              "host": ["{{base_url}}"],
              "path": ["test", "cars", "{{car_id}}"]
            },
            "body": { "mode": "raw", "raw": "{\n  \"remaining_percentage\": 15\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('상태코드 200', () => pm.response.to.have.status(200));",
                  "pm.test('경계값이 정확히 반영됨 (15)', () => {",
                  "  pm.expect(body.remaining_percentage).to.eql(15);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "비대면",
      "item": [
        {
          "name": "원격 잠금 해제 상태 주입 (is_locked=false)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/test/cars/{{car_id}}",
              "host": ["{{base_url}}"],
              "path": ["test", "cars", "{{car_id}}"]
            },
            "body": { "mode": "raw", "raw": "{\n  \"is_locked\": false\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('상태코드 200', () => pm.response.to.have.status(200));",
                  "pm.test('주입한 상태값이 반영됨 (is_locked=false)', () => {",
                  "  pm.expect(body.is_locked).to.eql(false);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "유효하지 않은 배터리 값 거부 검증 (remaining_percentage=150)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/test/cars/{{car_id}}",
              "host": ["{{base_url}}"],
              "path": ["test", "cars", "{{car_id}}"]
            },
            "body": { "mode": "raw", "raw": "{\n  \"remaining_percentage\": 150\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('범위를 벗어난 값은 422로 거부됨', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "공통",
      "item": [
        {
          "name": "차량 상태 조회 (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/test/cars/{{car_id}}",
              "host": ["{{base_url}}"],
              "path": ["test", "cars", "{{car_id}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('상태코드 200', () => pm.response.to.have.status(200));",
                  "pm.test('필수 필드가 모두 존재', () => {",
                  "  ['car_id','is_door_open','is_engine_on','is_locked','remaining_percentage','updated_at']",
                  "    .forEach((k) => pm.expect(body).to.have.property(k));",
                  "});",
                  "pm.test('car_id가 요청한 차량과 일치', () => {",
                  "  pm.expect(body.car_id).to.eql(pm.variables.get('car_id'));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
